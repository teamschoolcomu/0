window.YaGames = { init: () => ok(ysdk) };
var cloudSaves = NO_DATA, statsSaves = NO_DATA, allGamesData = NO_DATA, environmentData = NO_DATA, playerData = NO_DATA;

function lsGet(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }
function lsSet(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }
function quiet(f) { return function () { try { const r = f.apply(this, arguments); if (r && r.catch) r.catch(() => {}); return r; } catch (e) {} }; }
Element.prototype.requestPointerLock = quiet(Element.prototype.requestPointerLock);
if (Element.prototype.requestFullscreen) Element.prototype.requestFullscreen = quiet(Element.prototype.requestFullscreen);

document.addEventListener('contextmenu', e => e.preventDefault());
document.addEventListener('visibilitychange', () => SetVisibility(!document.hidden));
window.addEventListener('blur', () => SetVisibility(false));
window.addEventListener('focus', () => SetVisibility(true));
window.addEventListener('pointerdown', () => { FocusGame(); SetVisibility(true); });

function FocusGame() { if (!isPausedGame) canvas.focus({ preventScroll: true }); }
function SetVisibility(v) { if (initGame && isVisibility !== v) { isVisibility = v; YG2Instance('SetFocusWindowGame', v ? 'true' : 'false'); } }
function YG2Instance(method, arg) {
    if (!ygGameInstance) return;
    const send = () => { try { arg === undefined ? ygGameInstance.SendMessage('YG2Instance', method) : ygGameInstance.SendMessage('YG2Instance', method, arg); } catch (e) {} };
    initGame ? send() : setTimeout(send, 100);
}
function LogStyledMessage() {}
function InitGame() { initGame = true; }
function SaveCloud(d) { if (typeof d === 'string') lsSet(SAVE_KEY, d); }
function LoadCloud() { const d = lsGet(SAVE_KEY); cloudSaves = d ? JSON.stringify([d]) : NO_DATA; YG2Instance('SetLoadSaves', cloudSaves); return Promise.resolve(cloudSaves); }
function GetStats() { statsSaves = lsGet(STATS_KEY) || '{}'; YG2Instance('ReceiveStats', statsSaves); return Promise.resolve(statsSaves); }
function SetStats(j) { try { lsSet(STATS_KEY, JSON.stringify(Object.assign(JSON.parse(lsGet(STATS_KEY) || '{}'), JSON.parse(j)))); } catch (e) {} }
function GetAllGames() { return Promise.resolve(NO_DATA); }
function SetLeaderboard() {}
function GetLeaderboard(name) { YG2Instance('LeaderboardEntries', JSON.stringify({ technoName: name, isDefault: false, isInvertSortOrder: false, decimalOffset: 0, type: 'numeric', entries: NO_DATA, ranks: [], photos: [], names: [], scores: [], uniqueIDs: [], extraDataArray: [] })); }
function InterAdvShow() {}
function OpenAuthDialog() {}
function NotAuthorized() { return JSON.stringify({ playerAuth: "rejected", playerName: "unauthorized", playerId: "unauthorized", playerPhoto: NO_DATA, payingStatus: "unknown" }); }
function InitPlayer() { playerData = NotAuthorized(); YG2Instance('SetAuth', playerData); return Promise.resolve(playerData); }
function RequestingEnvironmentData() {
    const m = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
    environmentData = JSON.stringify({ language: 'en', domain: 'com', deviceType: m ? 'mobile' : 'desktop', isMobile: m, isDesktop: !m, isTablet: false, isTV: false, appID: '0', browserLang: 'en', payload: '', platform: navigator.platform || '', browser: 'Chrome' });
    YG2Instance('SetEnvirData', environmentData);
    return Promise.resolve(environmentData);
}
RequestingEnvironmentData(); InitPlayer(); LoadCloud(); GetStats();

const s = document.createElement("script");
s.src = BUILD_CDN + "wave2.loader.js";
s.onload = () => createUnityInstance(canvas, config, p => { const v = Math.round(p * 100); fill.style.width = v + '%'; txt.textContent = 'Loading ' + v + '%'; })
    .then(u => { ygGameInstance = u; ld.remove(); FocusGame(); })
    .catch(() => { txt.textContent = 'Load error, refresh the page'; });
s.onerror = () => { txt.textContent = 'Load error, refresh the page'; };
